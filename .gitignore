.DS_Store

# Locally packed boot images are release artifacts, not source files.
*.img
!blank_vbmeta.img

# The KernelSU manager is downloaded during installation, not shipped.
KernelSU_*.apk

# APK signing material and build output.
*.idsig
app/*.keystore
app/build/
app/out/

# Local dependency/build directories.
bridge/.build/
kernel/out/
__pycache__/
